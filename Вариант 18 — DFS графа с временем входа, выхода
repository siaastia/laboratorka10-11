def dfs(graph, v, visited, tin, tout, timer):
    visited[v] = True            # отмечаем вершину
    tin[v] = timer[0]           # время входа
    timer[0] += 1

    for to in graph[v]:
        if not visited[to]:
            dfs(graph, to, visited, tin, tout, timer)

    tout[v] = timer[0]          # время выхода
    timer[0] += 1


# Пример графа (список смежности)
graph = {
    0: [1, 2],
    1: [3],
    2: [3],
    3: []
}

visited = [False] * 4
tin = [0] * 4
tout = [0] * 4
timer = [1]

dfs(graph, 0, visited, tin, tout, timer)

print("Время входа:", tin)
print("Время выхода:", tout)
